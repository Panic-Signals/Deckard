# Native Instruments Maschine MK3 (17cc:1600): let the logged-in user reach its HID
# interface (pads, buttons, LEDs) and its USB interface (the displays) without root.
SUBSYSTEM=="usb", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1600", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1600", MODE="0660", TAG+="uaccess"
