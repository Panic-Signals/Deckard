# Native Instruments Maschine MK3 (17cc:1600) and Maschine+ (17cc:1820): let the logged-in
# user reach their HID interface (pads, buttons, LEDs) and their USB interface (the
# displays) without root.
SUBSYSTEM=="usb", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1600", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1600", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1820", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1820", MODE="0660", TAG+="uaccess"
